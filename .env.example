# ============================================
# ELIDE FIRE — Quote Railway App
# Copy file này thành .env và điền giá trị thật
# KHÔNG commit file .env lên git
# ============================================

# Server
PORT=3333
APP_URL=https://your-app.up.railway.app

# NocoDB
NOCODB_TOKEN=your_nocodb_token_here
NOCODB_HOST=nocodb-production-xxxx.up.railway.app
NOCODB_BASE=your_base_id_here
NOCODB_TABLE_NV=your_nhan_vien_table_id
NOCODB_TABLE_BG=your_bao_gia_table_id
NOCODB_TABLE_SP=your_san_pham_table_id
NOCODB_TABLE_HD=your_hop_dong_table_id
